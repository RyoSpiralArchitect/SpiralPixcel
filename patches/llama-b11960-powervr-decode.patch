index 0000000..cf10281
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_p021_pvr.comp
@@ -0,0 +1,106 @@
+#version 450
+// Attention scores for single-token decode on PowerVR: f16 K rows (KV positions, permuted as
+// in mul_mat_vec_p021.comp) times gqa_ratio query heads. The stock shader runs one workgroup
+// per position, and each workgroup costs about 0.5 us on this GPU. Here one 128-wide subgroup
+// covers 128 / TPR positions per pass with TPR invocations per position, the query heads are
+// staged once per workgroup in shared memory, and one clustered add finishes each dot product.
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#extension GL_KHR_shader_subgroup_clustered : require
+
+layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+layout(constant_id = 0) const uint BLOCK_SIZE = 128;  // equals the required subgroup size
+layout(constant_id = 1) const uint gqa_ratio = 1;     // query heads per K head, 1..8
+layout(constant_id = 2) const uint PASSES = 1;        // groups of BLOCK_SIZE / TPR positions per workgroup
+
+#ifndef TPR
+#define TPR 8  // invocations per position, fixed at compile time for the clustered add
+#endif
+// Query values staged per workgroup: gqa_ratio * ncols_x must not exceed this.
+#define MAX_Q 2048
+
+#define MAT_VEC_FUSION_FLAGS_BIAS0 0x1
+#define MAT_VEC_FUSION_FLAGS_BIAS1 0x2
+
+layout(binding = 0) readonly buffer AV4 { f16vec4 data_a_v4[]; };
+layout(binding = 1) readonly buffer BV4 { vec4 data_b_v4[]; };
+layout(binding = 2) writeonly buffer D { float data_d[]; };
+layout(binding = 3) readonly buffer Fuse0 { float data_fuse0[]; };
+layout(binding = 4) readonly buffer Fuse1 { float data_fuse1[]; };
+
+layout(push_constant) uniform parameter {
+    uint ncols_x;
+    uint nrows_x;
+    uint nchannels_x;
+    uint nchannels_y;
+    uint b_offset;
+    uint d_offset;
+    uint fusion_flags;
+} p;
+
+shared vec4 q_sh[MAX_Q / 4];
+
+void main() {
+    // The pipeline requires one full subgroup per workgroup, so these ids cover every lane.
+    const uint tid = gl_SubgroupInvocationID;
+    const uint lane = tid % TPR;
+    const uint slot = tid / TPR;
+    const uint SLOTS = BLOCK_SIZE / TPR;
+
+    uint channel, channel_x;
+    if (gqa_ratio > 1) {
+        channel_x = gl_WorkGroupID.z;
+        channel = channel_x * gqa_ratio;
+    } else {
+        channel = gl_WorkGroupID.z;
+        channel_x = channel / (p.nchannels_y / p.nchannels_x);
+    }
+
+    // The host requires ncols_x % 4 == 0.
+    const uint ncols4 = p.ncols_x / 4;
+    for (uint i = gl_LocalInvocationID.x; i < gqa_ratio * ncols4; i += BLOCK_SIZE) {
+        const uint c = i / ncols4;
+        q_sh[i] = data_b_v4[(channel + c) * ncols4 + i % ncols4];
+    }
+    barrier();
+
+    // x is transposed and permuted: position-major, then channel, then column.
+    const uint row_stride4 = p.nchannels_x * ncols4;
+    const uint first_row = gl_WorkGroupID.y * SLOTS * PASSES;
+    [[unroll]] for (uint pass = 0; pass < PASSES; ++pass) {
+        const uint row = first_row + pass * SLOTS + slot;
+        float temp[8];
+        [[unroll]] for (uint c = 0; c < 8; ++c) {
+            temp[c] = 0.0f;
+        }
+        if (row < p.nrows_x) {
+            const uint a4 = row * row_stride4 + channel_x * ncols4;
+            for (uint j = lane; j < ncols4; j += TPR) {
+                const vec4 a = vec4(data_a_v4[a4 + j]);
+                [[unroll]] for (uint c = 0; c < gqa_ratio; ++c) {
+                    temp[c] += dot(a, q_sh[c * ncols4 + j]);
+                }
+            }
+        }
+        [[unroll]] for (uint c = 0; c < gqa_ratio; ++c) {
+            temp[c] = subgroupClusteredAdd(temp[c], TPR);
+        }
+        if (lane == 0 && row < p.nrows_x) {
+            [[unroll]] for (uint c = 0; c < gqa_ratio; ++c) {
+                // dst is not transposed and not permuted
+                const uint idst = (channel + c) * p.nrows_x + row;
+                float v = temp[c];
+                if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS0) != 0) {
+                    v += data_fuse0[idst];
+                }
+                if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS1) != 0) {
+                    v += data_fuse1[idst];
+                }
+                data_d[idst] = v;
+            }
+        }
+    }
+}
