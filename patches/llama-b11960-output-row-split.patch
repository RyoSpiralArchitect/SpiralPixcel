--- a/src/llama-vulkan-split.h
+++ b/src/llama-vulkan-split.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+
+// Opt-in Qwen2 output-head experiment for devices with a 128 MiB storage range.
+// Chunk boundaries use 256 rows, so each byte offset is 256-byte aligned for any
+// integral row size. Both the weight and the loader's 512-token result probe fit.
+inline int64_t llama_vk_split_output_rows(const ggml_tensor * weight) {
+    const char * value = std::getenv("GGML_VK_SPLIT_OUTPUT");
+    if (!value || std::strcmp(value, "0") == 0) {
+        return 0;
+    }
+    if (std::strcmp(value, "1") != 0) {
+        throw std::runtime_error("GGML_VK_SPLIT_OUTPUT must be 0 or 1");
+    }
+    constexpr size_t range = 128u * 1024u * 1024u;
+    if (ggml_nbytes(weight) <= range || weight->ne[2] != 1 || weight->ne[3] != 1 ||
+        !ggml_is_contiguous(weight) || weight->type == GGML_TYPE_NVFP4) {
+        return 0;
+    }
+    const size_t row_bytes = ggml_row_size(weight->type, weight->ne[0]);
+    constexpr size_t chunk_bytes = 64u * 1024u * 1024u;
+    int64_t rows = std::min<int64_t>(65536, chunk_bytes / row_bytes);
+    rows -= rows % 256;
+    if (rows == 0) {
+        throw std::runtime_error("output head row exceeds the split experiment's 64 MiB budget");
+    }
+    return rows;
+}
