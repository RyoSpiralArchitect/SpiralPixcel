#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint width, height; float rate, decay; } p;

float sample_cell(ivec2 pos) {
    ivec2 edge = ivec2(p.width, p.height) - 1;
    ivec2 q = clamp(pos, ivec2(0), edge);
    return x[q.y * int(p.width) + q.x];
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(p.width) || pos.y >= int(p.height)) return;
    float c = sample_cell(pos);
    precise float near_sum = sample_cell(pos + ivec2(-1, 0)) + sample_cell(pos + ivec2(1, 0))
                           + sample_cell(pos + ivec2(0, -1)) + sample_cell(pos + ivec2(0, 1));
    precise float next = p.decay * (c + p.rate * (near_sum - 4.0 * c));
    y[pos.y * int(p.width) + pos.x] = next;
}
