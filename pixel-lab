#!/usr/bin/env -S python3 -IS
"""Run experiments on a Pixel Debian VM via the authenticated USB device."""
import argparse
import hashlib
import io
import ipaddress
import json
import os
from pathlib import Path
import re
import shlex
import subprocess as sp
import sys
import tarfile
import tempfile
import time
import uuid
from datetime import datetime, timezone

ROOT = Path(__file__).resolve().parent
STATE = Path(os.environ.get("SPIRALPIXCEL_STATE", Path.home() / "Library/Application Support/SpiralPixcel"))
# The executable runs in isolated Python mode; import only our bundled modules.
sys.path.insert(0, str(ROOT / "guest"))
sys.path.insert(0, str(ROOT / "host"))
KEY = STATE / "id_ed25519"
KNOWN = STATE / "known_hosts"
SHARE = "/sdcard/Download/SpiralPixcel"
RUN_ID = re.compile(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}")


def adb(*args):
    return sp.check_output(["adb", "-d", *args], timeout=15)


def pair():
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not KEY.exists():
        sp.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "SpiralPixcel", "-f", KEY], check=True)
    pub = sp.check_output(["ssh-keygen", "-y", "-f", KEY], text=True).split()
    key = " ".join(pub[:2]) + " SpiralPixcel"
    payload = ("mac_public_key=" + shlex.quote(key) + "\n").encode() + (ROOT / "guest/enroll.sh").read_bytes()
    digest = hashlib.sha256(payload).hexdigest()
    adb("shell", "mkdir", "-p", SHARE)
    with tempfile.NamedTemporaryFile() as f:
        f.write(payload)
        f.flush()
        adb("push", f.name, f"{SHARE}/pair")
    print("In the Pixel Debian terminal, run this once and read the SHA256 host fingerprint:")
    print(f'(cd "$(mktemp -d)" && cp /mnt/shared/Download/SpiralPixcel/pair p && sha256sum p | cut -c1-64 | grep -qx {digest} && sh p)')
    print("Then on the Mac: pixel-lab trust SHA256:<fingerprint shown by Debian>")


def trust(fingerprint):
    public = adb("exec-out", "cat", SHARE + "/vm-host.pub")
    actual = sp.check_output(["ssh-keygen", "-lf", "-"], input=public).decode().split()[1]
    if actual != fingerprint:
        raise ValueError("host fingerprint differs from Debian; pairing stopped")
    fields = public.decode("ascii").split()
    if fields[0] != "ssh-ed25519":
        raise ValueError("expected an Ed25519 host key")
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=STATE, delete=False) as f:
        f.write(f"spiralpixcel-vm {fields[0]} {fields[1]}\n".encode())
    os.replace(f.name, KNOWN)
    print("Pinned Debian's SSH host key.")


def ssh_command():
    if not KEY.is_file() or not KNOWN.is_file():
        raise ValueError("pair the VM first: pixel-lab pair")
    if os.environ.get("SPIRALPIXCEL_VM_IP"):
        candidates = [os.environ["SPIRALPIXCEL_VM_IP"]]
    else:
        neigh = adb("shell", "ip -4 neigh show dev avf_tap_fixed").decode()
        candidates = [line.split()[0] for line in neigh.splitlines() if line.split() and "FAILED" not in line]
        candidates.extend(adb("shell", f"cat {SHARE}/vm-ip 2>/dev/null || true").decode().split())
    for candidate in dict.fromkeys(candidates):
        ip = str(ipaddress.IPv4Address(candidate))
        cmd = ["ssh", "-F", "/dev/null", "-T", "-i", str(KEY), "-o", "IdentitiesOnly=yes",
               "-o", "HostKeyAlias=spiralpixcel-vm", "-o", "StrictHostKeyChecking=yes",
               "-o", 'UserKnownHostsFile="' + str(KNOWN) + '"', "-o", "BatchMode=yes",
               "-o", "ConnectTimeout=5", "-o", "ServerAliveInterval=10", "-o", "ServerAliveCountMax=3",
               "-o", "ProxyCommand=adb -d shell -T nc -w 5 %h %p", "droid@" + ip]
        if sp.run(cmd + ["true"], stdin=sp.DEVNULL, stdout=sp.DEVNULL, stderr=sp.DEVNULL).returncode == 0:
            return cmd
    raise ValueError("cannot reach the paired VM; open Debian in Terminal, check USB, or set SPIRALPIXCEL_VM_IP")


def collect(ssh, run_id):
    if not RUN_ID.fullmatch(run_id):
        raise ValueError("invalid run ID")
    dest = Path("runs") / run_id
    dest.mkdir(parents=True, exist_ok=True)
    base = f".local/share/SpiralPixcel/runs/{run_id}"
    # Stream regular files only. Temporary files keep interrupted downloads retryable.
    proc = sp.Popen(ssh + [f"cd {base}/result && tar -cf - ."], stdout=sp.PIPE)
    try:
        with tarfile.open(fileobj=proc.stdout, mode="r|") as tar:
            for member in tar:
                if member.name == "." and member.isdir():
                    continue
                name = member.name.removeprefix("./")
                if not re.fullmatch(r"[a-zA-Z0-9_.-]+", name) or name in (".", "..") or not member.isfile() or member.size > 32*1024*1024:
                    raise ValueError("unexpected result entry")
                data = tar.extractfile(member).read()
                with tempfile.NamedTemporaryFile(dir=dest, delete=False) as f:
                    f.write(data)
                os.replace(f.name, dest / name)
    finally:
        proc.stdout.close()
        rc = proc.wait()
    if rc:
        raise ValueError("download interrupted; collect this run again")
    print(f"Results: {dest.resolve()}")
    receipt = dest / "result.json"
    if receipt.is_file():
        result = json.loads(receipt.read_text())
        print(f"{result['experiment']}: {result['status']} on {result['vulkan']['device']}")
        if result["experiment"] == "doctor":
            print(f"{result['elements']} integers, {result['mismatches']} mismatches")
        elif result["experiment"] == "inference":
            if result["status"] == "pass":
                print(f"decode tg32: {result['decode_tg32_tokens_s']:.2f} tokens/s")
                print(f"peak process RSS: {result['sampled_peak_rss_kib']} KiB")
            else:
                print(result.get("error", "benchmark failed"), file=sys.stderr)
        elif result["experiment"] == "diffusion":
            for checkpoint in result["checkpoints"]:
                print(f"step {checkpoint['step']:>4}: max |GPU - CPU| = {checkpoint['max_abs_error']:.3g}")
            print(f"Image: {(dest / 'field.png').resolve()}")
        return result["status"] == "pass"
    print("No completed result yet. See build-run.log, or try collect again.", file=sys.stderr)
    return False


def execute(ssh, args):
    run_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ-") + uuid.uuid4().hex[:12]
    base = f".local/share/SpiralPixcel/runs/{run_id}"
    print(f"Run {run_id}", flush=True)
    blob = io.BytesIO()
    with tarfile.open(fileobj=blob, mode="w:gz") as tar:
        if getattr(args, "trace", None):
            with args.trace.open("rb") as f:
                raw = f.read(128*1024 + 1)
            from touch import decode
            decode(raw)
            entry = tarfile.TarInfo("replay.json")
            entry.size = len(raw)
            tar.addfile(entry, io.BytesIO(raw))
        for p in sorted((ROOT / "guest").rglob("*")):
            if p.is_file() and p.suffix in (".comp", ".cpp", ".py"):
                tar.add(p, arcname=str(p.relative_to(ROOT / "guest")), recursive=False)
    start = time.monotonic()
    sp.run(ssh + [f"umask 077 && mkdir -p ~/.local/share/SpiralPixcel/runs && mkdir {base} && cd {base} && mkdir result && tar -xzf -"],
           input=blob.getvalue(), check=True)
    guest_args = [args.command]
    if args.command == "run" and args.experiment == "diffusion":
        guest_args = ["diffusion", "--steps", str(args.steps), "--rate", str(args.rate), "--decay", str(args.decay)]
        if args.trace:
            guest_args += ["--trace", "replay.json"]
    if args.command == "run" and args.experiment == "inference":
        inference_args = ["--gpu-layers", str(args.gpu_layers), "--repetitions", str(args.repetitions),
                          "--profile", args.profile, "--flash-attn", args.flash_attn, "--repack", str(args.repack)]
        for flag in ("runtime", "model"):
            value = getattr(args, flag)
            if value:
                inference_args += ["--" + flag, value]
        if args.split_output:
            inference_args += ["--split-output"]
        if args.schedule_report:
            inference_args += ["--schedule-report"]
        if args.disable_fp16:
            inference_args += ["--disable-fp16"]
        if args.workgroup:
            inference_args += ["--workgroup", str(args.workgroup)]
        if args.rms_subgroups:
            inference_args += ["--rms-subgroups"]
        # The integer GPU check completes in the same guest source snapshot first.
        command = "python3 experiment.py doctor && cp result/result.json result/doctor.json"
        command += " && python3 inference.py " + shlex.join(inference_args)
    else:
        command = "python3 experiment.py " + shlex.join(guest_args)
    cmd = f"cd {base} && {{ {command}; }} >result/build-run.log 2>&1"
    completed = sp.run(ssh + [cmd])
    success = collect(ssh, run_id)
    if completed.returncode or not success:
        raise ValueError(f"run incomplete or failed; inspect runs/{run_id}/build-run.log")
    (Path("runs") / run_id / "host.json").write_text(json.dumps({
        "transport": "SSH via USB ADB", "run_id": run_id, "source_archive_sha256": hashlib.sha256(blob.getvalue()).hexdigest(),
        "upload_run_collect_seconds": round(time.monotonic() - start, 3)}, indent=2) + "\n")
    return Path("runs") / run_id


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("pair", help="enroll a dedicated Mac key in the Debian VM")
    commands.add_parser("trust", help="pin the fingerprint displayed on the Pixel").add_argument("fingerprint")
    commands.add_parser("draw", help="draw on the Pixel and compare two GPU replays")
    commands.add_parser("doctor", help="double integers on the Vulkan device and verify every value")
    commands.add_parser("collect", help="recover results from an earlier run").add_argument("run_id")
    session = commands.add_parser("session", help="optional display setup, recovery and bounded guest jobs")
    sessions = session.add_subparsers(dest="session_action", required=True)
    sessions.add_parser("status", help="read effective power and keyguard state")
    sessions.add_parser("prepare", help="save settings; request AC/USB stay-awake and a 30-minute timeout")
    sessions.add_parser("restore", help="restore the saved display settings on the same device")
    screen_check = sessions.add_parser("check", help="check Android frame-capture responsiveness")
    screen_check.add_argument("--require-unlocked", action="store_true")
    recovery = sessions.add_parser("recover", help="wake/home; optionally stop Terminal or reboot normally")
    recovery.add_argument("--stop-vm", action="store_true", help="force-stop Terminal and its VM")
    recovery.add_argument("--reboot", action="store_true", help="request normal Android reboot")
    bounded = sessions.add_parser("run", help="run one guest command with a guest-owned deadline")
    bounded.add_argument("--seconds", type=float, default=20)
    bounded.add_argument("--require-unlocked", action="store_true")
    bounded.add_argument("guest_command", nargs=argparse.REMAINDER)
    run = commands.add_parser("run", help="run a field experiment")
    experiments = run.add_subparsers(dest="experiment", required=True)
    diffusion = experiments.add_parser("diffusion", help="compare a 128x128 GPU field against a CPU reference")
    diffusion.add_argument("--steps", type=int, default=96)
    diffusion.add_argument("--rate", type=float, default=0.18)
    diffusion.add_argument("--decay", type=float, default=0.995)
    inference = experiments.add_parser("inference", help="doctor followed by a bounded llama.cpp model benchmark")
    inference.add_argument("--runtime", help="absolute runtime path in the Debian VM")
    inference.add_argument("--model", help="absolute GGUF path in the Debian VM")
    inference.add_argument("--gpu-layers", type=int, default=99, choices=range(1000), metavar="N")
    inference.add_argument("--repetitions", type=int, default=3, choices=range(1, 21), metavar="N")
    inference.add_argument("--repack", type=int, choices=(0, 1), default=1)
    inference.add_argument("--split-output", action="store_true", help="held Qwen2 row-split experiment; full-model gate required")
    inference.add_argument("--schedule-report", action="store_true", help="record graph placement separately from timing")
    inference.add_argument("--disable-fp16", action="store_true", help="FP32 control using the same runtime")
    inference.add_argument("--workgroup", type=int, choices=(32, 64, 128), help="patched PowerVR MMV workgroup")
    inference.add_argument("--flash-attn", choices=("off", "on"), default="off")
    inference.add_argument("--rms-subgroups", action="store_true")
    inference.add_argument("--profile", choices=("baseline", "host-memory", "mmvq"), default="baseline")
    diffusion.add_argument("--trace", type=Path, help="replay touch/v1 JSON before the requested free diffusion steps")
    args = parser.parse_args()
    if args.command == "run" and args.experiment == "inference" and args.split_output:
        if not args.gpu_layers:
            parser.error("--split-output requires GPU layers")
        if args.flash_attn != "off":
            parser.error("--split-output currently requires --flash-attn off")
    if args.command == "run" and args.experiment == "diffusion" and not (1 <= args.steps <= 1024 and 0 <= args.rate <= 0.25 and 0 <= args.decay <= 1):
        parser.error("steps: 1..1024, rate: 0..0.25, decay: 0..1")
    if args.command == "pair":
        pair()
    elif args.command == "trust":
        trust(args.fingerprint)
    elif args.command == "draw":
        from draw import serve
        serve(adb, ssh_command, execute)
    elif args.command == "collect":
        if not collect(ssh_command(), args.run_id):
            sys.exit(1)
    elif args.command == "session":
        import lab_session
        device = lab_session.Device()
        if args.session_action == "run":
            command = args.guest_command[1:] if args.guest_command[:1] == ["--"] else args.guest_command
            sys.exit(lab_session.run_bounded(device, ssh_command(), ROOT, command, args.seconds, args.require_unlocked))
        if args.session_action == "status":
            result = device.state()
        elif args.session_action == "prepare":
            result = lab_session.prepare(device, STATE)
        elif args.session_action == "restore":
            result = lab_session.restore(device, STATE)
        elif args.session_action == "check":
            result = lab_session.check(device, args.require_unlocked)
        else:
            result = lab_session.recover(device, args.stop_vm, args.reboot)
        print(json.dumps(result, indent=2))
    else:
        execute(ssh_command(), args)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, sp.SubprocessError, tarfile.TarError) as exc:
        sys.exit(f"pixel-lab: {exc}")
