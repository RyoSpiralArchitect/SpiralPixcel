@@ -779,6 +779,18 @@ void ggml_vk_buffer_read_2d(vk_buffer& src, size_t offset, void * dst, size_t sp
             src->device->device.invalidateMappedMemoryRanges(
                 vk::MappedMemoryRange{src->device->sync_staging->device_memory, 0, VK_WHOLE_SIZE});
         }
+        // A pinned destination took the copy directly (ggml_vk_buffer_read_2d_async). The VM can
+        // return stale zeros from it unless it is invalidated as well; this path runs only when the
+        // source is not host-visible, as with GGML_VK_PREFER_DEVICE_LOCAL on UMA.
+        if (split_output && strcmp(split_output, "1") == 0) {
