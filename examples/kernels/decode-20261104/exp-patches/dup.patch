+// Timing ablation for the Pixel study. GGML_VK_SKIP_OPS=SOFT_MAX,MUL_MAT:f16 leaves matching nodes,
+// and any ops fused into them, unrecorded; GGML_VK_DUP_OPS records them twice with a barrier between.
+// Entries are op names, optionally with the src0 type. Results are invalid while either is set.
+static std::set<std::string> ggml_vk_op_list(const char * env) {
+    std::set<std::string> names;
+    if (const char * value = getenv(env)) {
+        std::string list(value);
+        size_t start = 0;
+        while (start <= list.size()) {
+            size_t end = list.find(',', start);
+            if (end == std::string::npos) {
+                end = list.size();
+            }
+            if (end > start) {
+                names.insert(list.substr(start, end - start));
             }
-            GGML_LOG_WARN("ggml_vulkan: GGML_VK_SKIP_OPS=%s, results are invalid\n", value);
+            start = end + 1;
         }
-        return names;
-    }();
-    if (skip.empty()) {
+        GGML_LOG_WARN("ggml_vulkan: %s=%s, results are invalid\n", env, value);
+    }
+    return names;
+}
+
+static bool ggml_vk_op_listed(const std::set<std::string> & names, const ggml_tensor * node) {
+    if (names.empty()) {
         return false;
     }
     const std::string op = ggml_op_name(node->op);
-    return skip.count(op) || (node->src[0] && skip.count(op + ":" + ggml_type_name(node->src[0]->type)));
+    return names.count(op) || (node->src[0] && names.count(op + ":" + ggml_type_name(node->src[0]->type)));
+}
+
+static bool ggml_vk_skip_op(const ggml_tensor * node) {
+    static const std::set<std::string> skip = ggml_vk_op_list("GGML_VK_SKIP_OPS");
+    return ggml_vk_op_listed(skip, node);
+}
+
+static bool ggml_vk_dup_op(const ggml_tensor * node) {
+    static const std::set<std::string> dup = ggml_vk_op_list("GGML_VK_DUP_OPS");
+    return ggml_vk_op_listed(dup, node);
 }
 
