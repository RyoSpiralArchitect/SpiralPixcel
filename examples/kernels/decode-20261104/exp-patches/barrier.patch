+// With compute-only barriers, a copy or fill on the compute queue first waits for earlier shader
+// and transfer accesses here (read-after-write and write-after-read).
+void ggml_vk_sync_before_transfer(vk_context& subctx) {
+    if (!subctx->p->q->compute_only_barrier) {
+        return;
